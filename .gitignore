# 원본 전사본과 그 파생물.
# 금융감독원 공개 녹취와 AI Hub 음성에서 온 자료라 재배포가 허용되지 않는다 —
# 받는 방법은 fetch.py, 조건은 README.md 참고.
*.csv
*.jsonl
*.json
repo/
finetune/

# 드라이브에 올릴 파일만 모아둔 폴더. build_binary_set.py 로 언제든 다시 만든다.
colab_upload/

# 손으로 만든 평가 자료는 커밋한다 — 이게 없으면 개선을 잰 근거가 사라진다.
#   stage_gold.jsonl   id·정답 단계·한 줄 인용구. 원문 전체가 아니라 인용 범위다
#   hard_normal.jsonl  지어낸 문장이라 재배포 제한이 없다
!eval/stage_gold.jsonl
!eval/hard_normal.jsonl

# 학습 산출물. 체크포인트는 중간 상태일 뿐이라 커밋하지 않는다.
adapter/*
adapter-gemma4/*
checkpoint-*/

# 현역 어댑터(gemma4)는 통째로 커밋한다. "재현 가능하니 빼자"가 여기서는 성립하지 않는다 —
# 4bit 양자화와 GPU 커널의 비결정성 때문에 다시 학습해도 같은 가중치가 나오지 않고,
# calibration.json 의 온도는 이 가중치의 로짓에 맞춰 구한 값이라 짝이 어긋나면
# 에러 없이 확률만 조용히 틀어진다. 받는 사람이 재현하는 게 아니라 이걸 그대로 써야 한다.
# 토크나이저를 함께 두는 것은 어댑터 폴더를 자기완결로 만들기 위해서다(계약 파일).
!adapter-gemma4/adapter_model.safetensors
!adapter-gemma4/adapter_config.json
!adapter-gemma4/tokenizer.json
!adapter-gemma4/tokenizer_config.json
!adapter-gemma4/chat_template.jinja
!adapter-gemma4/calibration.json
!adapter-gemma4/prompt.json
!adapter-gemma4/README.md

# 이전 산출물(Gemma 3)은 계약 두 개만. 가중치가 125MiB 라 GitHub 파일 상한을 넘는다.
!adapter/calibration.json
!adapter/prompt.json

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
.DS_Store
